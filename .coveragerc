[run]
branch = True
source =
    tools
    server

[report]
# A floor, not a target: the app and tools measured 99.45% on 2026-10-03 (fido2
# comes from PyPI and is not measured), and 99.25% in the python:3.12-slim image,
# where tools/commit_messages.py's tests skip for want of git. Set just below the
# lower figure so a real regression fails. Raise it when coverage rises; never
# lower it to go green.
fail_under = 99.2
# coverage compares the total rounded to this many places with the floor.
precision = 2
omit =
    tests/*
    */tests/*
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
