[run]
branch = True
source =
    tools
    server

[report]
# A floor, not a target: the app and tools measured 96.7% on 2026-09-30 (fido2
# comes from PyPI and is not measured). Set below that so a real regression
# fails but ordinary churn does not. Raise it when coverage rises; never lower
# it to go green.
fail_under = 95
omit =
    tests/*
    */tests/*
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
