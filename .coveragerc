[run]
branch = True
source =
    fido2
    tools
    server

[report]
# A floor, not a target: measured 95.42% on 2026-09-17. Set just under it so a
# real regression fails but ordinary churn does not. Raise it when coverage
# rises; never lower it to go green.
fail_under = 95
omit =
    tests/*
    */tests/*
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
