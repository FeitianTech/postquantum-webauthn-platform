# Ignore version control and build artefacts to keep the build context small.
.git
.gitignore
__pycache__
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info
*.log
*.tmp
.mypy_cache
.pytest_cache
.tox
.nox
.coverage
htmlcov
build
dist
.eggs
*.swp
.idea
.vscode
.env
venv
ENV
.venv
.DS_Store

# Local runtime state: stored credential artifacts, session metadata, the
# persisted session secret and the MDS snapshot (instance/mds-snapshot, which is
# provisioned at runtime, never baked in). None of it is copied into the image,
# but without these lines a local `docker build` still sends it as context.
server/runtime
instance
node_modules
coverage

# The web/ build runs inside the image's own Node stage; local installs and
# outputs are not context.
web/node_modules
web/.next
web/out
web/coverage
web/test-results
web/playwright-report
