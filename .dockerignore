# Ignore version control and build artefacts to keep the build context small.
.git
.gitignore
__pycache__
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info
*.log
*.tmp
.mypy_cache
.pytest_cache
.tox
.nox
.coverage
htmlcov
build
dist
.eggs
*.swp
.idea
.vscode
.env
venv
ENV
.venv
.DS_Store

# The MDS snapshot is provisioned at runtime, not baked into the image: keeping
# it out of the build context stops a daily refresh invalidating a 30MB layer.
frontend/static/blob.jwt
frontend/static/fido-mds3.verified.json
frontend/static/fido-mds3.verified.json.meta.json
frontend/static/fido-mds3.explorer.json
frontend/static/fido-mds3.explorer.json.meta.json
frontend/static/fido-mds3.explorer.full.json
frontend/static/fido-mds3.explorer.full.json.meta.json

# Local runtime state: stored credential artifacts, session metadata and the
# persisted session secret. None of it is copied into the image, but without
# these lines a local `docker build` still sends it to the daemon as context.
server/runtime
instance
node_modules
coverage

# The web/ build runs inside the image's own Node stage; local installs and
# outputs are not context. new_design/ is an untracked visual reference.
web/node_modules
web/.next
web/out
web/coverage
web/test-results
web/playwright-report
new_design
