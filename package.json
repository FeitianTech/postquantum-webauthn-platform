{
  "name": "postquantum-webauthn-platform-frontend-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test:frontend": "vitest run",
    "test:frontend:coverage": "vitest run --coverage",
    "test:python": "python -m pytest -q",
    "test:python:coverage": "coverage run -m pytest -q -p no:cov && coverage report -m",
    "test:all": "npm run test:frontend && npm run test:python"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.1",
    "vitest": "^5.0.1"
  }
}
